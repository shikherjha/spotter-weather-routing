# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# sqlite:///db.sqlite3 locally; postgres://user:pass@host:5432/db in prod
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0

# --- Routing ---
# tomtom | here | osrm   (osrm = public demo server, car-only, dev use)
ROUTING_PROVIDER=osrm
TOMTOM_API_KEY=
HERE_API_KEY=

# --- Weather ---
# Open-Meteo needs no key. Paid plans use customer-api.open-meteo.com + key.
OPEN_METEO_API_KEY=
WEATHER_MODEL=ncep_nbm_conus

# --- AI ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
