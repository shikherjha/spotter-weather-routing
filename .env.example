# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0

# --- Routing ---
# valhalla (our own server, truck-aware; TomTom as backup if a key is set)
# | tomtom (truck-aware, needs a key) | osrm (public demo server, car speeds, dev use)
ROUTING_PROVIDER=osrm
TOMTOM_API_KEY=
VALHALLA_URL=
VALHALLA_TOKEN=

# --- Weather ---
# `make worker` keeps a local copy of NOAA's NBM, NWS zones and alerts in DATA_DIR (default ./var);
# trips use it when it's fresh and Open-Meteo otherwise. Open-Meteo needs no key.
# DATA_DIR=/data
OPEN_METEO_API_KEY=
WEATHER_MODEL=ncep_nbm_conus

# --- Jev (TypeSafe AI): reads NWS warnings and typed trips. Optional: keyword rules stand in without it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
