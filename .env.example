# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0

# --- Routing ---
# tomtom (truck-aware, needs a key) | osrm (public demo server, car speeds, dev use)
ROUTING_PROVIDER=osrm
TOMTOM_API_KEY=

# --- Weather ---
# Open-Meteo needs no key. Paid plans use customer-api.open-meteo.com + key.
OPEN_METEO_API_KEY=
WEATHER_MODEL=ncep_nbm_conus

# --- Jev (TypeSafe AI): reads NWS warnings and typed trips. Optional: keyword rules stand in without it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
